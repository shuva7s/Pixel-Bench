{
  "name": "pixel-bench",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter desktop tauri dev",
    "build": "pnpm --filter desktop tauri build",
    "build:ui": "pnpm --filter desktop build",
    "test": "pnpm test:rust && pnpm test:js",
    "test:rust": "cargo test --workspace --release",
    "test:js": "pnpm --filter desktop test",
    "test:e2e": "pnpm --filter desktop test:e2e",
    "lint": "pnpm --filter desktop lint && cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "pnpm --filter desktop typecheck",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
